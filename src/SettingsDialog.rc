#include <windows.h>
#include "SettingsDialogResource.h"

LANGUAGE 9, 1

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 286, 190
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "NppTerminal Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Default shell:", -1, 10, 12, 76, 12
    COMBOBOX        IDC_SETTINGS_SHELL, 92, 10, 182, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Default directory:", -1, 10, 36, 76, 12
    EDITTEXT        IDC_SETTINGS_DIRECTORY, 92, 34, 182, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Font family:", -1, 10, 60, 76, 12
    EDITTEXT        IDC_SETTINGS_FONT_FAMILY, 92, 58, 182, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Font size:", -1, 10, 84, 76, 12
    EDITTEXT        IDC_SETTINGS_FONT_SIZE, 92, 82, 58, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "Scrollback:", -1, 160, 84, 60, 12
    EDITTEXT        IDC_SETTINGS_SCROLLBACK, 222, 82, 52, 14, ES_NUMBER | WS_TABSTOP
    AUTOCHECKBOX    "Confirm before killing a session", IDC_SETTINGS_CONFIRM_KILL, 10, 108, 264, 14, WS_TABSTOP
    DEFPUSHBUTTON   "Save", IDOK, 118, 164, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 174, 164, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Reset", IDC_SETTINGS_RESET, 230, 164, 44, 14, WS_TABSTOP
END
