#include <windows.h>
#include "Version.h"

LANGUAGE 9, 1
1 VERSIONINFO
FILEVERSION NPPTERMINAL_VERSION_FILE_COMMA
PRODUCTVERSION NPPTERMINAL_VERSION_FILE_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "NppTerminal contributors\0"
            VALUE "FileDescription", "NppTerminal session broker\0"
            VALUE "FileVersion", NPPTERMINAL_VERSION_STRING "\0"
#ifdef NPPTERMINAL_TESTS
            VALUE "InternalName", "NppTerminalBroker.Tests.exe\0"
            VALUE "OriginalFilename", "NppTerminalBroker.Tests.exe\0"
#else
            VALUE "InternalName", "NppTerminalBroker.exe\0"
            VALUE "OriginalFilename", "NppTerminalBroker.exe\0"
#endif
            VALUE "ProductName", "NppTerminal\0"
            VALUE "ProductVersion", NPPTERMINAL_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
